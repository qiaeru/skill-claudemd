// Markdown hygiene for the repo. Prose is written one paragraph per
// logical line, so no line-length limit. Emphasis and strong both use
// asterisks, matching the repo's existing prose. CLAUDE.md is gitignored
// local notes, excluded so local runs match CI.
{
  "config": {
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD049": { "style": "asterisk" },
    "MD050": { "style": "asterisk" }
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "CLAUDE.md"]
}
