# Claude Code working files, local to the dev machine. The eval fixtures are
# CLAUDE.md files too, and must stay tracked.
CLAUDE.md
!evals/fixtures/*/CLAUDE.md
.claude/

# Operating systems.
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Editors and IDEs.
.vscode/
.idea/
*.swp
*.swo
*.swn
*~

# Backups and temporary files.
*.bak
*.tmp
*.orig

# Eval run artifacts written by claude plugin eval. The eval cases
# themselves, evals/, are versioned.
**/evals/results/
