# Claude Code working files, local to the dev machine. The eval fixtures are
# CLAUDE.md files too, and must stay tracked.
CLAUDE.md
!skills/*/evals/files/*/CLAUDE.md
.claude/

# Operating systems.
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Editors and IDEs.
.vscode/
.idea/
*.swp
*.swo
*.swn
*~

# Backups and temporary files.
*.bak
*.tmp
*.orig

# Skill eval run artifacts (skill-creator workspace, plugin eval results).
# The eval cases themselves, skills/*/evals/, are versioned.
skills/*-workspace/
**/evals/results/
